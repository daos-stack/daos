diff --git a/src/na/na.h b/src/na/na.h
index abc1234..def5678 100644
--- a/src/na/na.h
+++ b/src/na/na.h
@@ -808,6 +808,38 @@ NA_PUBLIC na_return_t
 NA_Mem_handle_deserialize(na_class_t *na_class, na_mem_handle_t **mem_handle_p,
     const void *buf, size_t buf_size);
 
+/**
+ * Import a remote memory handle from a raw (third-party) RDMA key.
+ *
+ * This creates a remote NA memory handle from an externally-created RDMA
+ * memory registration key, without performing local memory registration.
+ * The resulting handle can be used as the remote_mem_handle parameter in
+ * NA_Put() / NA_Get() operations.
+ *
+ * This is intended for importing RDMA descriptors from external systems
+ * such as NVIDIA cuFile (GPUDirect Storage), where the GPU buffer's memory
+ * registration is performed by nvidia-fs and the serialized key is passed
+ * to the storage plugin via cufileRDMAInfo_t.
+ *
+ * \param na_class [IN/OUT]     pointer to NA class
+ * \param mem_handle_p [OUT]    pointer to returned NA memory handle
+ * \param rkey_buf [IN]         raw RDMA key buffer (transport-specific):
+ *                                - OFI: uint64_t fi_mr_key or raw key blob
+ *                                - UCX: not supported (returns NA_OPNOTSUPPORTED)
+ * \param rkey_buf_size [IN]    size of rkey_buf in bytes
+ * \param remote_base_addr [IN] remote base virtual address of the memory region
+ * \param remote_size [IN]      size of the remote memory region in bytes
+ * \param flags [IN]            permission flag:
+ *                                - NA_MEM_READWRITE
+ *                                - NA_MEM_READ_ONLY
+ *
+ * \return NA_SUCCESS or corresponding NA error code
+ */
+NA_PUBLIC na_return_t
+NA_Mem_handle_import_rkey(na_class_t *na_class,
+    na_mem_handle_t **mem_handle_p, const void *rkey_buf,
+    size_t rkey_buf_size, uint64_t remote_base_addr, uint64_t remote_size,
+    unsigned long flags);
+
 /**
  * Put data to remote address.
  * Initiate a put to the registered memory regions with the given offset/size.
@@ -1094,6 +1126,15 @@ NA_Mem_handle_import_rkey(na_class_t *na_class,
      * Operations struct — plugin function pointer table
      */
     na_return_t (*mem_handle_deserialize)(na_class_t *na_class,
         na_mem_handle_t **mem_handle_p, const void *buf, size_t buf_size);
+    /**
+     * Import a remote memory handle from a raw third-party RDMA key.
+     * Optional — may be NULL if the transport does not support it.
+     */
+    na_return_t (*mem_handle_import_rkey)(na_class_t *na_class,
+        na_mem_handle_t **mem_handle_p, const void *rkey_buf,
+        size_t rkey_buf_size, uint64_t remote_base_addr,
+        uint64_t remote_size, unsigned long flags);
     na_return_t (*put)(na_class_t *na_class, na_context_t *context,
         na_cb_t callback, void *arg, na_mem_handle_t *local_mem_handle,
         na_offset_t local_offset, na_mem_handle_t *remote_mem_handle,
diff --git a/src/na/na.c b/src/na/na.c
index abc1234..def5678 100644
--- a/src/na/na.c
+++ b/src/na/na.c
@@ -1930,6 +1930,48 @@ error:
     return ret;
 }
 
+/*---------------------------------------------------------------------------*/
+na_return_t
+NA_Mem_handle_import_rkey(na_class_t *na_class,
+    na_mem_handle_t **mem_handle_p, const void *rkey_buf,
+    size_t rkey_buf_size, uint64_t remote_base_addr, uint64_t remote_size,
+    unsigned long flags)
+{
+    na_return_t ret;
+
+    NA_CHECK_SUBSYS_ERROR(mem, na_class == NULL, error, ret, NA_INVALID_ARG,
+        "NULL NA class");
+    NA_CHECK_SUBSYS_ERROR(mem, mem_handle_p == NULL, error, ret, NA_INVALID_ARG,
+        "NULL pointer to memory handle");
+    NA_CHECK_SUBSYS_ERROR(mem, rkey_buf == NULL, error, ret, NA_INVALID_ARG,
+        "NULL rkey buffer");
+    NA_CHECK_SUBSYS_ERROR(mem, rkey_buf_size == 0, error, ret, NA_INVALID_ARG,
+        "Zero rkey buffer size");
+    NA_CHECK_SUBSYS_ERROR(mem, remote_size == 0, error, ret, NA_INVALID_ARG,
+        "Zero remote size");
+
+    NA_CHECK_SUBSYS_ERROR(mem,
+        na_class->ops == NULL || na_class->ops->mem_handle_import_rkey == NULL,
+        error, ret, NA_OPNOTSUPPORTED,
+        "mem_handle_import_rkey plugin callback is not defined");
+
+    ret = na_class->ops->mem_handle_import_rkey(
+        na_class, mem_handle_p, rkey_buf, rkey_buf_size,
+        remote_base_addr, remote_size, flags);
+    NA_CHECK_SUBSYS_NA_ERROR(mem, error, ret,
+        "Could not import rkey into mem handle");
+
+    NA_LOG_SUBSYS_DEBUG(mem,
+        "Imported rkey into mem handle (%p), base=0x%" PRIx64 ", size=%" PRIu64,
+        (void *) *mem_handle_p, remote_base_addr, remote_size);
+
+    return NA_SUCCESS;
+
+error:
+    return ret;
+}
+
 /*---------------------------------------------------------------------------*/
 na_return_t
 NA_Put(na_class_t *na_class, na_context_t *context, na_cb_t callback,
