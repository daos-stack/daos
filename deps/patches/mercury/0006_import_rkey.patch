+    na_ofi_mem_handle_import_rkey,         /* mem_handle_import_rkey */
     na_ofi_put,                            /* put */
     na_ofi_get,                            /* get */
     na_ofi_poll_get_fd,                    /* poll_get_fd */
@@ -9713,6 +9720,62 @@ error:
     return ret;
 }
 
+/*---------------------------------------------------------------------------*/
+/**
+ * Import a remote memory handle from a raw OFI memory key.
+ *
+ * For providers using FI_MR_PROV_KEY (basic MR mode), rkey_buf is expected
+ * to contain the uint64_t fi_mr_key. For scalable MR mode or providers
+ * requiring raw keys, rkey_buf should be the output of fi_mr_raw_attr().
+ *
+ * The resulting handle can be used as remote_mem_handle in put/get operations.
+ */
+static na_return_t
+na_ofi_mem_handle_import_rkey(na_class_t NA_UNUSED *na_class,
+    na_mem_handle_t **mem_handle_p, const void *rkey_buf,
+    size_t rkey_buf_size, uint64_t remote_base_addr, uint64_t remote_size,
+    unsigned long flags)
+{
+    struct na_ofi_mem_handle *na_ofi_mem_handle = NULL;
+    na_return_t ret;
+
+    /* For OFI, we expect the rkey_buf to contain the fi_mr_key (uint64_t).
+     * Some providers may use larger raw keys — this basic implementation
+     * handles the common case of a 64-bit key. */
+    NA_CHECK_SUBSYS_ERROR(mem, rkey_buf_size < sizeof(uint64_t), error, ret,
+        NA_INVALID_ARG,
+        "rkey_buf too small for OFI (need >= 8 bytes, got %zu)",
+        rkey_buf_size);
+
+    na_ofi_mem_handle =
+        (struct na_ofi_mem_handle *) calloc(1, sizeof(*na_ofi_mem_handle));
+    NA_CHECK_SUBSYS_ERROR(mem, na_ofi_mem_handle == NULL, error, ret, NA_NOMEM,
+        "Could not allocate NA OFI memory handle");
+
+    /* Fill descriptor info — single contiguous segment */
+    na_ofi_mem_handle->desc.info.iovcnt = 1;
+    na_ofi_mem_handle->desc.info.len = remote_size;
+    na_ofi_mem_handle->desc.info.flags = (uint8_t)(flags & 0xff);
+
+    /* Extract the fi_mr_key from the raw buffer */
+    memcpy(&na_ofi_mem_handle->desc.info.fi_mr_key, rkey_buf,
+        sizeof(uint64_t));
+
+    /* Set up single IOV segment for the remote region */
+    na_ofi_mem_handle->desc.iov.s[0].iov_base =
+        (void *)(uintptr_t) remote_base_addr;
+    na_ofi_mem_handle->desc.iov.s[0].iov_len = (size_t) remote_size;
+
+    /* No local fi_mr — this is a remote-only handle */
+    na_ofi_mem_handle->fi_mr = NULL;
+
+    *mem_handle_p = (na_mem_handle_t *) na_ofi_mem_handle;
+
+    NA_LOG_SUBSYS_DEBUG(mem,
+        "Imported OFI rkey (fi_mr_key=0x%" PRIx64 ") for remote region "
+        "[0x%" PRIx64 ", %" PRIu64 " bytes]",
+        na_ofi_mem_handle->desc.info.fi_mr_key,
+        remote_base_addr, remote_size);
+
+    return NA_SUCCESS;
+
+error:
+    free(na_ofi_mem_handle);
+    return ret;
+}
+
 /*---------------------------------------------------------------------------*/
 static na_return_t
 na_ofi_put(na_class_t *na_class, na_context_t *context, na_cb_t callback,
