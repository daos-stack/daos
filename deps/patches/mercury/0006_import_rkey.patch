diff --git a/src/mercury_bulk.h b/src/mercury_bulk.h
index abc1234..def5678 100644
--- a/src/mercury_bulk.h
+++ b/src/mercury_bulk.h
@@ -82,6 +82,25 @@ HG_Bulk_create_attr(hg_class_t *hg_class, uint32_t count, void **buf_ptrs,
     hg_bulk_t *handle);
 
 /**
+ * Create a remote bulk handle by importing a raw (third-party) RDMA key.
+ *
+ * This creates a bulk handle suitable for use as the remote/origin handle
+ * in HG_Bulk_transfer(). It does not register any local memory — it wraps
+ * an externally-created RDMA memory registration (e.g., from NVIDIA cuFile).
+ *
+ * \param hg_class [IN]            pointer to HG class
+ * \param rkey_buf [IN]            raw RDMA key buffer (transport-specific)
+ * \param rkey_buf_size [IN]       size of rkey_buf
+ * \param remote_base_addr [IN]    remote base address of the memory region
+ * \param remote_size [IN]         size of the remote region in bytes
+ * \param flags [IN]               permission flags (HG_BULK_READWRITE,
+ *                                 HG_BULK_READ_ONLY, or HG_BULK_WRITE_ONLY)
+ * \param handle [OUT]             pointer to returned bulk handle
+ *
+ * \return HG_SUCCESS or corresponding HG error code
+ */
+HG_PUBLIC hg_return_t
+HG_Bulk_import_rkey(hg_class_t *hg_class, const void *rkey_buf,
+    size_t rkey_buf_size, uint64_t remote_base_addr, uint64_t remote_size,
+    unsigned long flags, hg_bulk_t *handle);
+
+/**
  * Free bulk handle.
  *
  * \param handle [IN/OUT]       abstract bulk handle
diff --git a/src/mercury_bulk.c b/src/mercury_bulk.c
index abc1234..def5678 100644
--- a/src/mercury_bulk.c
+++ b/src/mercury_bulk.c
@@ -2793,6 +2793,80 @@ error:
     return ret;
 }
 
+/*---------------------------------------------------------------------------*/
+hg_return_t
+HG_Bulk_import_rkey(hg_class_t *hg_class, const void *rkey_buf,
+    size_t rkey_buf_size, uint64_t remote_base_addr, uint64_t remote_size,
+    unsigned long flags, hg_bulk_t *handle)
+{
+    hg_core_class_t *core_class;
+    na_class_t *na_class;
+    struct hg_bulk *hg_bulk = NULL;
+    unsigned long na_flags;
+    na_return_t na_ret;
+    hg_return_t ret;
+
+    HG_CHECK_SUBSYS_ERROR(bulk, hg_class == NULL, error, ret, HG_INVALID_ARG,
+        "NULL HG class");
+    HG_CHECK_SUBSYS_ERROR(bulk, handle == NULL, error, ret, HG_INVALID_ARG,
+        "NULL bulk handle pointer");
+    HG_CHECK_SUBSYS_ERROR(bulk, rkey_buf == NULL, error, ret, HG_INVALID_ARG,
+        "NULL rkey buffer");
+    HG_CHECK_SUBSYS_ERROR(bulk, rkey_buf_size == 0, error, ret, HG_INVALID_ARG,
+        "Zero rkey buffer size");
+    HG_CHECK_SUBSYS_ERROR(bulk, remote_size == 0, error, ret, HG_INVALID_ARG,
+        "Zero remote size");
+
+    core_class = hg_class->core_class;
+    na_class = HG_Core_class_get_na(core_class);
+
+    /* Map HG bulk flags to NA memory flags */
+    switch (flags) {
+    case HG_BULK_READ_ONLY:
+        na_flags = NA_MEM_READ_ONLY;
+        break;
+    case HG_BULK_WRITE_ONLY:
+        na_flags = NA_MEM_WRITE_ONLY;
+        break;
+    default:
+        na_flags = NA_MEM_READWRITE;
+        break;
+    }
+
+    /* Allocate bulk handle */
+    hg_bulk = (struct hg_bulk *) calloc(1, sizeof(*hg_bulk));
+    HG_CHECK_SUBSYS_ERROR(bulk, hg_bulk == NULL, error, ret, HG_NOMEM,
+        "Could not allocate bulk handle");
+
+    hg_bulk->core_class = core_class;
+    hg_bulk->na_class = na_class;
+    hg_bulk->registered = false;
+    hg_atomic_init32(&hg_bulk->ref_count, 1);
+    hg_core_bulk_incr(core_class);
+
+    /* Set up descriptor — single segment, remote-only */
+    hg_bulk->desc.info.len = remote_size;
+    hg_bulk->desc.info.segment_count = 1;
+    hg_bulk->desc.info.flags = (uint8_t) flags;
+
+    /* Set segment base/len (remote address, not locally dereferenceable) */
+    hg_bulk->desc.segments.s[0].base = (void *)(uintptr_t) remote_base_addr;
+    hg_bulk->desc.segments.s[0].len = (hg_size_t) remote_size;
+
+    /* Import the rkey into an NA memory handle */
+    na_ret = NA_Mem_handle_import_rkey(na_class,
+        &hg_bulk->na_mem_descs.handles.s[0], rkey_buf, rkey_buf_size,
+        remote_base_addr, remote_size, na_flags);
+    HG_CHECK_SUBSYS_ERROR(bulk, na_ret != NA_SUCCESS, error_free, ret,
+        (hg_return_t) na_ret,
+        "NA_Mem_handle_import_rkey() failed (%s)",
+        NA_Error_to_string(na_ret));
+
+    /* No address bound */
+    hg_bulk->addr = HG_CORE_ADDR_NULL;
+
+    *handle = (hg_bulk_t) hg_bulk;
+
+    HG_LOG_SUBSYS_DEBUG(bulk,
+        "Created imported rkey bulk handle (%p), size=%" PRIu64,
+        (void *) hg_bulk, remote_size);
+
+    return HG_SUCCESS;
+
+error_free:
+    hg_core_bulk_decr(core_class);
+    free(hg_bulk);
+error:
+    return ret;
+}
+
 /*---------------------------------------------------------------------------*/
 hg_return_t
 HG_Bulk_transfer(hg_context_t *context, hg_cb_t callback, void *arg,
--

Design notes:
=============

1. The new function pointer is inserted into struct na_class_ops (na.h)
   between mem_handle_deserialize and put. All backends must add an entry
   at this position — UCX and OFI provide implementations, others set NULL.

2. The public API NA_Mem_handle_import_rkey() dispatches through the vtable:
     na_class->ops->mem_handle_import_rkey(...)
   If the backend sets NULL, NA_OPNOTSUPPORTED is returned.

3. UCX implementation mirrors the deserialization path exactly:
   - Allocates na_ucx_mem_handle
   - Stores raw rkey in rkey_buf field
   - Sets type = NA_UCX_MEM_HANDLE_REMOTE_PACKED
   - On first put/get, na_ucx_rkey_unpack() calls ucp_ep_rkey_unpack()
   The only difference from deserialize: no Mercury wire-format header parsing.

4. OFI implementation constructs a minimal remote handle:
   - Populates fi_mr_key from rkey_buf (first 8 bytes)
   - Sets up a single-segment iov with the remote base addr + len
   - na_ofi_put/get use desc.info.fi_mr_key as the remote key in fi_write/fi_read

5. HG_Bulk_import_rkey() in mercury_bulk.c:
   - Allocates hg_bulk, sets up single-segment descriptor
   - Calls NA_Mem_handle_import_rkey() to create the NA remote handle
   - No local buffers — remote-only handle, freed via standard HG_Bulk_free()

6. nvidia-fs rkey format compatibility:
   - nvidia-fs likely uses raw IB verbs rkeys (ibv_reg_mr output)
   - For OFI/verbs: the raw IB rkey maps directly to fi_mr_key ✓
   - For UCX: ucp_rkey_pack() output includes transport-specific headers
     that raw IB rkeys lack; a UCT-level approach or translation may be
     needed. Testing with actual nvidia-fs output is required.
