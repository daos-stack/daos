 na_ucx_put(na_class_t *na_class, na_context_t *context, na_cb_t callback,
     void *arg, na_mem_handle_t *local_mem_handle, na_offset_t local_offset,
@@ -1004,6 +1010,7 @@ const struct na_class_ops NA_PLUGIN_OPS(ucx) = {
     na_ucx_mem_handle_get_serialize_size, /* mem_handle_get_serialize_size */
     na_ucx_mem_handle_serialize,          /* mem_handle_serialize */
     na_ucx_mem_handle_deserialize,        /* mem_handle_deserialize */
+    na_ucx_mem_handle_import_rkey,        /* mem_handle_import_rkey */
     na_ucx_put,                           /* put */
     na_ucx_get,                           /* get */
     na_ucx_poll_get_fd,                   /* poll_get_fd */
@@ -4491,6 +4498,62 @@ error:
     return ret;
 }
 
+/*---------------------------------------------------------------------------*/
+/**
+ * Import a remote memory handle from a raw RDMA key — not supported on UCX.
+ *
+ * UCX uses ucp_rkey_pack()/ucp_ep_rkey_unpack() with its own internal
+ * serialization format that is not ABI-compatible with raw verbs rkeys
+ * (e.g., from nvidia-fs GPUDirect Storage). Rather than silently producing
+ * a corrupt handle, we return NA_OPNOTSUPPORTED so the caller can fall back
+ * to normal memory registration (which UCX handles natively for CUDA memory
+ * via its HMEM infrastructure).
+ */
+static na_return_t
+na_ucx_mem_handle_import_rkey(na_class_t NA_UNUSED *na_class,
+    na_mem_handle_t NA_UNUSED **mem_handle_p,
+    const void NA_UNUSED *rkey_buf,
+    size_t NA_UNUSED rkey_buf_size,
+    uint64_t NA_UNUSED remote_base_addr,
+    uint64_t NA_UNUSED remote_size,
+    unsigned long NA_UNUSED flags)
+{
+    NA_LOG_SUBSYS_DEBUG(mem,
+        "UCX does not support raw rkey import — caller should fall back "
+        "to normal HMEM registration");
+
+    return NA_OPNOTSUPPORTED;
+}
+
 /*---------------------------------------------------------------------------*/
 static na_return_t
 na_ucx_put(na_class_t *na_class, na_context_t *context, na_cb_t callback,
