"""Build versioned object store tests"""


def build_dlck_engine_macros_ut(henv):
    """Build dlck_engine_macros_ut"""
    henv.Append(OBJPREFIX="dlck_engine_macros_ut_")
    henv.require('argobots', 'cmocka')

    henv.d_test_program('dlck_engine_macros_ut', ['dlck_engine_macros_ut.c'],
                        LIBS=['gurt', 'cmocka'])


def build_dlck_engine_ut(henv):
    """Build dlck_engine_ut"""
    henv.Append(OBJPREFIX="dlck_engine_ut_")
    henv.Append(CPPPATH=[Dir('../../../').srcnode()])
    henv.AppendUnique(LINKFLAGS=['-Wl,--wrap=d_calloc', '-Wl,--wrap=d_free',
                                 '-Wl,--wrap=dss_tls_init', '-Wl,--wrap=dss_tls_fini',
                                 '-Wl,--wrap=dss_tls_get', '-Wl,--wrap=ds_tls_key_create',
                                 '-Wl,--wrap=ds_tls_key_delete', '-Wl,--wrap=daos_register_key',
                                 '-Wl,--wrap=daos_unregister_key',
                                 '-Wl,--wrap=daos_get_module_key', '-Wl,--wrap=ABT_thread_join',
                                 '-Wl,--wrap=ABT_thread_free', '-Wl,--wrap=ABT_thread_yield',
                                 '-Wl,--wrap=ABT_pool_is_empty', '-Wl,--wrap=ABT_eventual_create',
                                 '-Wl,--wrap=ABT_eventual_free', '-Wl,--wrap=ABT_eventual_set',
                                 '-Wl,--wrap=ABT_eventual_test'])
    henv.require('argobots', 'cmocka')

    libs = ['gurt', 'daos_common_pmem', 'cmocka', 'uuid', 'abt', 'pthread']

    srcs = [
        'dlck_engine_ut.c',
        'dlck_engine_ut_mock.c',
        '../dlck_engine.c',
    ]
    henv.d_test_program('dlck_engine_ut', srcs, LIBS=libs)


def build_dlck_test_helper(henv):
    """Build dlck_test_helper"""
    henv.Append(OBJPREFIX="dlck_ut_helper_")
    henv.Append(CPPPATH=[Dir('../../../').srcnode()])
    henv.AppendUnique(RPATH_FULL=['$PREFIX/lib64/daos_srv'])
    henv.require('argobots', 'cmocka')

    libs = [
        'vos_srv', 'gurt', 'daos_common_pmem', 'bio', 'cmocka', 'uuid', 'dtx', 'abt', 'pthread'
    ]

    srcs = [
        'dlck_test_helper.c',
        'dlck_test_helper_args.c',
        '../dlck_abt.c',
        '../dlck_args_engine.c',
        '../dlck_args_files.c',
        '../dlck_args_parse.c',
        '../dlck_engine.c',
        '../dlck_pool.c',
        '../dlck_tls.c',
        '../../../dtx/tests/srv_mock.c',
        '../../../dtx/tests/ult_mock.c',
        '../../../dtx/tests/pl_map_mock.c',
        '../../../dtx/tests/sched_mock.c',
        '../../../engine/util.c',
        '../../../mgmt/mgmt_common.c',
    ]
    henv.d_test_program('dlck_test_helper', srcs, LIBS=libs)


def build_dlck_args_ut(henv):
    """Build dlck_args_ut"""
    henv.Append(OBJPREFIX="dlck_args_ut_")
    henv.AppendUnique(LINKFLAGS=['-Wl,--wrap=argp_failure'])
    henv.require('cmocka')

    libs = [
        'gurt', 'daos_common_pmem', 'cmocka', 'uuid'
    ]

    srcs = [
        'dlck_args_ut.c',
        '../dlck_args_common.c',
        '../dlck_args_engine.c',
        '../dlck_args_files.c',
        '../dlck_args_parse.c',
        '../dlck_args.c',
    ]
    henv.d_test_program('dlck_args_ut', srcs, LIBS=libs)


def build_dlck_checker_common_ut(henv):
    """Build dlck_checker_common_ut"""
    henv.require('cmocka')

    henv.d_test_program('dlck_checker_common_ut', ['dlck_checker_common_ut.c'],
                        LIBS=['gurt', 'cmocka'])


def build_dlck_checker_macros_ut(henv):
    """Build dlck_checker_macros_ut"""
    henv.Append(OBJPREFIX="dlck_checker_macros_ut_")
    henv.AppendUnique(LINKFLAGS=['-Wl,--wrap=vfprintf', '-Wl,--wrap=__vfprintf_chk',
                                 '-Wl,--wrap=d_log_sync'])
    henv.require('argobots', 'cmocka')

    libs = ['gurt', 'daos_common_pmem', 'cmocka']
    srcs = ['dlck_checker_macros_ut.c', 'dlck_checker_ut_mock.c']
    henv.d_test_program('dlck_checker_macros_ut', srcs, LIBS=libs)


def build_dlck_checker_main_ut(henv):
    """Build dlck_checker_main_ut"""
    henv.Append(OBJPREFIX="dlck_checker_main_ut_")
    henv.AppendUnique(LINKFLAGS=['-Wl,--wrap=ABT_mutex_create', '-Wl,--wrap=ABT_mutex_free',
                                 '-Wl,--wrap=ABT_mutex_lock', '-Wl,--wrap=ABT_mutex_unlock',
                                 '-Wl,--wrap=vfprintf', '-Wl,--wrap=__vfprintf_chk',
                                 '-Wl,--wrap=fflush', '-Wl,--wrap=d_calloc',
                                 '-Wl,--wrap=d_free'])
    henv.require('argobots', 'cmocka')

    libs = ['gurt', 'daos_common_pmem', 'cmocka', 'uuid', 'abt']

    srcs = [
        'dlck_checker_main_ut.c',
        'dlck_checker_ut_mock.c',
        '../dlck_checker.c',
    ]
    henv.d_test_program('dlck_checker_main_ut', srcs, LIBS=libs)


def build_dlck_checker_worker_ut(henv):
    """Build dlck_checker_worker_ut"""
    henv.Append(OBJPREFIX="dlck_checker_worker_ut_")
    henv.AppendUnique(LINKFLAGS=['-Wl,--wrap=fopen', '-Wl,--wrap=fclose', '-Wl,--wrap=d_asprintf2',
                                 '-Wl,--wrap=vfprintf', '-Wl,--wrap=__vfprintf_chk',
                                 '-Wl,--wrap=fflush',
                                 '-Wl,--wrap=d_calloc', '-Wl,--wrap=d_free'])
    henv.require('argobots', 'cmocka')

    libs = ['gurt', 'daos_common_pmem', 'cmocka', 'uuid', 'abt']
    srcs = [
        'dlck_checker_worker_ut.c',
        'dlck_checker_ut_mock.c',
        '../dlck_checker.c'
    ]
    henv.d_test_program('dlck_checker_worker_ut', srcs, LIBS=libs)


def scons():
    """Execute build"""
    Import('env')

    build_dlck_test_helper(env.Clone())
    build_dlck_args_ut(env.Clone())
    build_dlck_checker_common_ut(env.Clone())
    build_dlck_checker_macros_ut(env.Clone())
    build_dlck_checker_main_ut(env.Clone())
    build_dlck_checker_worker_ut(env.Clone())
    build_dlck_engine_macros_ut(env.Clone())
    build_dlck_engine_ut(env.Clone())


if __name__ == "SCons.Script":
    scons()
