"""Build drpc test"""


def scons():
    """Execute build"""
    Import('env')

    libs = ['daos', 'daos_common', 'cmocka', 'gurt']
    sources = ['rpc_tests.c']

    denv = env.Clone()
    denv.AppendUnique(CPPDEFINES=['TEST'])

    # Testing internal interfaces ...
    denv.AppendUnique(CPPPATH=[Dir('../../').srcnode()])

    denv.d_test_program('rpc_tests', sources, LIBS=libs)

    henv = denv.Clone()
    henv.require('mercury')
    henv.AppendUnique(LIBS=['cart', 'gurt', 'cmocka', 'pthread'])
    henv.d_test_program('cart_hdr_tests', ['cart_hdr_tests.c'])


if __name__ == "SCons.Script":
    scons()
