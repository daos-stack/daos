# Go-runtime, bytealg, and glibc/loader rules have moved to memcheck-go.supp.
# Load that file alongside this one for any valgrind-tagged Go binary.

# libfabric (OFI)
{
   libfabric: provider init (fi_ini)
   Memcheck:Leak
   ...
   fun:fi_ini
   ...
}
{
   libfabric: rdma_bind_addr init
   Memcheck:Leak
   match-leak-kinds: possible
   ...
   fun:rdma_bind_addr
   ...
}
{
   libfabric: tcp/rxm sends uninitialized bytes (msg_iov[1])
   Memcheck:Param
   sendmsg(msg.msg_iov[1])
   ...
   fun:ofi_bsock_sendv
   ...
}
{
   libfabric: tcp/rxm sends uninitialized bytes (msg_iov[2])
   Memcheck:Param
   sendmsg(msg.msg_iov[2])
   ...
   fun:ofi_bsock_sendv
   ...
}
{
   libfabric: send() uninitialized bytes
   Memcheck:Param
   socketcall.sendto(msg)
   ...
   fun:send
}

# Mercury (HG)
{
   mercury: hg_dlog_mkcount32
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   fun:hg_dlog_mkcount32
   ...
}
{
   mercury: hg_dlog_mkcount64
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   fun:hg_dlog_mkcount64
   ...
}

# BoringCrypto / OpenSSL
{
   boringcrypto: dlopen of libssl
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:calloc
   fun:_dlerror_run
   fun:dlopen*
   fun:_goboringcrypto_DLOPEN_OPENSSL
   fun:_cgo_*_Cfunc__goboringcrypto_DLOPEN_OPENSSL
   fun:runtime.asmcgocall
}
